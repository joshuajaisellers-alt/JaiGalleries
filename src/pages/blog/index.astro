---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogPosts, formatDate } from "../../data/blog";
import { sitePath } from "../../lib/paths";

const posts = getBlogPosts();
---

<BaseLayout title="Blog — Jai Sellers Galleries">
  <h1>Blog</h1>
  <p class="meta">
    Local photo journals and notes. Add new posts in <code>src/data/blog.ts</code>
    and images in <code>public/photos/blog</code>.
  </p>

  <section class="section grid">
    {
      posts.map((post) => (
        <article class="card" style="grid-column: span 6;">
          {
            post.coverImage && (
              <img
                src={sitePath(post.coverImage)}
                alt={post.coverAlt || post.title}
                style="width:100%;height:260px;object-fit:cover;margin-bottom:0.75rem;"
              />
            )
          }
          <h2>
            <a href={sitePath(`blog/${post.slug}`)}>{post.title}</a>
          </h2>
          <p class="meta">{formatDate(post.date)}</p>
          <p>{post.excerpt}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
