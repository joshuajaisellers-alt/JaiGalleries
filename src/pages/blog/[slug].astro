---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogPosts, getBlogPostBySlug, formatDate } from "../../data/blog";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = slug ? getBlogPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect(sitePath("blog"));
}
---

<BaseLayout title={`${post.title} — Blog`} description={post.excerpt}>
  <article>
    <h1>{post.title}</h1>
    <p class="meta">{formatDate(post.date)}</p>

    {
      post.coverImage && (
        <img
          src={sitePath(post.coverImage)}
          alt={post.coverAlt || post.title}
          style="width:100%;max-height:560px;object-fit:cover;margin:1rem 0 1.5rem;"
        />
      )
    }

    <div class="post-content">
      {post.content.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      post.photos.length > 0 && (
        <section class="section">
          <h2>Photo Set</h2>
          <div class="photo-grid">
            {post.photos.map((photo) => (
              <figure>
                <img src={sitePath(photo.src)} alt={photo.alt} />
                {photo.caption && <figcaption>{photo.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
