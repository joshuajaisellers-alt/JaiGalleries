---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPortfolioSafe,
  getPortfolioBySlugSafe,
  formatDate,
  featuredImage,
} from "../../lib/wp";

export async function getStaticPaths() {
  const itemsResult = await getPortfolioSafe(100);
  return itemsResult.data.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/portfolio");
}

const itemResult = await getPortfolioBySlugSafe(slug);
const item = itemResult.data;

if (!item) {
  return Astro.redirect("/portfolio");
}

const hero = featuredImage(item);
const customFields = item.acf || item.meta || {};
---

<BaseLayout title={`${item.title.rendered} — Portfolio`}>
  <article>
    <h1>{item.title.rendered}</h1>
    <p class="meta">{formatDate(item.date)}</p>

    {
      hero && (
        <img
          src={hero}
          alt={item.title.rendered}
          style="width:100%;max-height:520px;object-fit:cover;margin:1rem 0 1.5rem;"
        />
      )
    }

    <div class="case-content" set:html={item.content?.rendered || ""} />

    {
      Object.keys(customFields).length > 0 && (
        <section class="section">
          <h2>Project Details</h2>
          <div class="card">
            <pre style="white-space:pre-wrap;margin:0;">
              {JSON.stringify(customFields, null, 2)}
            </pre>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
