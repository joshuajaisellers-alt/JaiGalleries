---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts, getPortfolio, formatDate, featuredImage } from "../lib/wp";

const [posts, portfolioItems] = await Promise.all([getPosts(3), getPortfolio(3)]);
---

<BaseLayout title="Jai Sellers — Consulting">
  <section>
    <h1>Strategic Consulting for Growth and Clarity</h1>
    <p class="meta">
      Minimal, practical strategy across operations, systems, and digital
      execution.
    </p>
  </section>

  <section class="section">
    <h2>Latest Blog Posts</h2>
    <div class="grid">
      {
        posts.map((post) => (
          <article class="card" style="grid-column: span 12;">
            <h3>
              <a href={`/blog/${post.slug}`}>{post.title.rendered}</a>
            </h3>
            <p class="meta">{formatDate(post.date)}</p>
            <div set:html={post.excerpt?.rendered || ""} />
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2>Latest Portfolio Work</h2>
    <div class="grid">
      {
        portfolioItems.map((item) => {
          const image = featuredImage(item);
          return (
            <article class="card" style="grid-column: span 4;">
              {
                image && (
                  <img
                    src={image}
                    alt={item.title.rendered}
                    style="width:100%;height:220px;object-fit:cover;margin-bottom:0.75rem;"
                  />
                )
              }
              <h3>
                <a href={`/portfolio/${item.slug}`}>{item.title.rendered}</a>
              </h3>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
